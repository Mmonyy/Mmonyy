-- 11. Trova i docenti che non insegnano nessuna materia
SELECT * 
FROM Docenti 
WHERE CodDocente NOT IN (SELECT CodDocente FROM Materie);

-- 12. Conta quanti studenti sono iscritti a ciascun corso, ordinato per numero di studenti decrescente
SELECT CodCorso, COUNT(Matricola) AS NumeroStudenti
FROM Studenti
GROUP BY CodCorso
ORDER BY NumeroStudenti DESC;

-- 13. Trova i corsi che hanno più di 30 studenti iscritti
SELECT CodCorso, COUNT(Matricola) AS NumeroStudenti
FROM Studenti
GROUP BY CodCorso
HAVING COUNT(Matricola) > 30;

-- 14. mostra la media dei voti per ogni studente, ma solo per gli studenti di verona
SELECT S.Matricola, S.Nome, S.Cognome, AVG(E.Voto) AS MediaVoti
FROM Studenti S
JOIN Esami E ON S.Matricola = E.Matricola
WHERE S.Citta = 'Verona'
GROUP BY S.Matricola, S.Nome, S.Cognome;

-- 15. Trova la facoltà con il maggior numero di studenti iscritti
SELECT TOP 1 C.Facolta, COUNT(S.Matricola) AS NumeroStudenti
FROM Corsi C
JOIN Studenti S ON C.CodCorso = S.CodCorso
GROUP BY C.Facolta
ORDER BY NumeroStudenti DESC;
