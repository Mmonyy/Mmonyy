sql-- 1. Tabella Docenti (indipendente)
CREATE TABLE Docenti (
    CodDocente INT PRIMARY KEY,
    Nome VARCHAR(50),
    Cognome VARCHAR(50),
    Dipartimento VARCHAR(100)
);

-- 2. Tabella Corsi (indipendente)
CREATE TABLE Corsi (
    CodCorso INT PRIMARY KEY,
    NomeCorso VARCHAR(100),
    Facolta VARCHAR(100),
    Durata INT
);

-- 3. Tabella Studenti (dipende da Corsi)
CREATE TABLE Studenti (
    Matricola INT PRIMARY KEY,
    Nome VARCHAR(50),
    Cognome VARCHAR(50),
    Citta VARCHAR(50),
    AnnoNascita INT,
    CodCorso INT,
    FOREIGN KEY (CodCorso) REFERENCES Corsi(CodCorso)
);

-- 4. Tabella Materie (dipende da Docenti)
CREATE TABLE Materie (
    CodMateria INT PRIMARY KEY,
    Nome VARCHAR(100),
    Cognome VARCHAR(50), 
    CFU INT,
    CodDocente INT,
    FOREIGN KEY (CodDocente) REFERENCES Docenti(CodDocente)
);

-- 5. Tabella Esami (dipende da Studenti e Materie)
CREATE TABLE Esami (
    Matricola INT,
    CodMateria INT,
    Data DATE,
    Voto INT,
    PRIMARY KEY (Matricola, CodMateria, Data),
    FOREIGN KEY (Matricola) REFERENCES Studenti(Matricola),
    FOREIGN KEY (CodMateria) REFERENCES Materie(CodMateria)
);
